---
import Layout from "@/layouts/Layout.astro";
import "../styles/global.css";
import { MaintenancePage } from "@/components/maintenance/MaintenancePage";
const API_URL = process.env.PUBLIC_API_URL || "http://localhost:8080";

try {
  const res = await fetch(`${API_URL}/api/maintenance/status?t=${Date.now()}`);
  if (res.ok) {
    const data = await res.json();
    if (data.status !== "maintenance") {
      return Astro.redirect("/", 307);
    }
  }
} catch {}
---

<Layout title="Pemeliharaan Sistem | E-SOP Digital Kemenag Barito Utara">
  <MaintenancePage client:load />
</Layout>